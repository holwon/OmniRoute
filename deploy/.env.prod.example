# ──────────────────────────────────────────────────────────────────────
#  OmniRoute — Production .env template (deploy/ folder)
#  Copy to .env:  cp .env.prod.example .env
#  Then edit the secrets below. This is the same env contract as the
#  repo-root .env.example; only the values that matter for a pull-based
#  Docker deployment are listed here.
#
#  ⚠️  The real deploy/.env already exists with generated secrets and
#  low-memory tuning — if you redeploy elsewhere, regenerate the three
#  secrets below instead of reusing them.
# ──────────────────────────────────────────────────────────────────────

# ═════════════════════════════════════════════════════════════════════
# 1. REQUIRED SECRETS — set strong random values before first run!
# ═════════════════════════════════════════════════════════════════════
# Generate:  openssl rand -base64 48
JWT_SECRET=

# Generate:  openssl rand -hex 32
API_KEY_SECRET=

# Initial admin login password — CHANGE after first login.
# Default CHANGEME is insecure; always set a real password here.
INITIAL_PASSWORD=CHANGEME
# Optional: encrypt the SQLite database at rest.
# Generate:  openssl rand -hex 32   |   Leave empty to disable.
# STORAGE_ENCRYPTION_KEY=
# STORAGE_ENCRYPTION_KEY_VERSION=v1

# ═════════════════════════════════════════════════════════════════════
# 2. NETWORK & PORTS (host-side published ports)
# ═════════════════════════════════════════════════════════════════════
# Dashboard UI
PORT=20128
DASHBOARD_PORT=20128
# OpenAI-compatible API
API_PORT=20129
# Live WebSocket dashboard
LIVE_WS_PORT=20132

# Image to pull. Lean by default; switch to the -web flavor if you need
# web-cookie providers (gemini-web, claude-web, claude-turnstile):
#   OMNIROUTE_IMAGE=ghcr.io/holwon/omniroute:next-web
# OMNIROUTE_IMAGE=ghcr.io/holwon/omniroute:next

# ═════════════════════════════════════════════════════════════════════
# 3. PUBLIC URL / HTTPS (reverse proxy)
# ═════════════════════════════════════════════════════════════════════
# Set AUTH_COOKIE_SECURE=true and point NEXT_PUBLIC_BASE_URL at your real
# domain when serving over HTTPS (nginx/Caddy/Cloudflare tunnel).
AUTH_COOKIE_SECURE=false
NEXT_PUBLIC_BASE_URL=http://localhost:20128
# BASE_URL=http://localhost:20128

# ═════════════════════════════════════════════════════════════════════
# 4. SECURITY POLICY
# ═════════════════════════════════════════════════════════════════════
# Require an API key for all /v1/* proxy endpoints (recommended true for
# any public or multi-user deployment).
REQUIRE_API_KEY=false

# Allow provider URLs pointing to private/local networks — REQUIRED for
# self-hosted providers (LM Studio, Ollama, vLLM, ...).
# OMNIROUTE_ALLOW_PRIVATE_PROVIDER_URLS=true

# ═════════════════════════════════════════════════════════════════════
# 5. RUNTIME
# ═════════════════════════════════════════════════════════════════════
# Node heap ceiling in MB. The image default is 1024. On a low-memory
# host (e.g. 1.5GB total) lower it — but be aware: V8 heap is only part
# of the process RSS, so a heap of 512 still uses ~700-900MB RSS. Keep
# the container mem_limit (below) a few hundred MB above the heap.
# NOTE: never use the -web image on a low-memory host (Chromium needs
# several hundred MB more).
OMNIROUTE_MEMORY_MB=512

# Hard memory ceiling for the OmniRoute container (docker-compose mem_limit).
# Must be comfortably above OMNIROUTE_MEMORY_MB. Default 1g.
OMNIROUTE_MEM_LIMIT=1g

# Shared secret for the internal Codex Responses WebSocket bridge.
# REQUIRED in production — if unset, all WS bridge requests are rejected.
# Generate:  openssl rand -base64 32
# OMNIROUTE_WS_BRIDGE_SECRET=
